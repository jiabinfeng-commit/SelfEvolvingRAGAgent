# =============================================================================
# .env.example —— 配置模板，复制为 .env 后填入真实值
#
#   cp .env.example .env        # 本地
#   # 云上：手动编辑 /opt/rag-agent/app/.env
#
# 注意：
#   - .env 已加入 .gitignore，**不会被提交**，放心填真实密码
#   - .env.example 没有真实值，会被提交，作为团队模板
#   - 优先级：系统环境变量 > .env > 代码默认值
# =============================================================================


# ---------- PostgreSQL ----------
# 存 chunk 原文与元数据
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag
PG_USER=rag
# 本地起一个最简 PG（Docker）：
#   docker run -d --name rag-pg -p 5432:5432 \
#     -e POSTGRES_USER=rag -e POSTGRES_PASSWORD=你的密码 -e POSTGRES_DB=rag \
#     postgres:16
PG_PASSWORD=请填写真实密码，不要提交到 git


# ---------- Milvus Lite ----------
# 只需要改路径的话改这里
MILVUS_PATH=
MILVUS_COLLECTION=chunks


# ---------- Embedding ----------
# 模型根目录，scripts/fetch_model.py 会把模型放在 {MODEL_ROOT}/BAAI__bge-small-zh-v1.5
MODEL_ROOT=
# 想要换别的模型可以覆盖这个 id
EMBED_MODEL=
EMBED_DIM=512
EMBED_BATCH_SIZE=32


# ---------- 路径 ----------
# 云上留空，脚本会自动用 /opt/rag-agent/app 作为基准
# 本地可以显式覆盖，比如 RAG_BASE_DIR=/Users/you/projects/Self_Evolving_RAG_Agent
RAG_BASE_DIR=
RAG_CORPUS_DIR=


# ---------- LLM（阶段 2：生成答案用） ----------
# 后端：ollama（本地免费，默认） | openai（OpenAI 兼容 API）
LLM_BACKEND=ollama
# ollama 模式填本地模型名；openai 模式填模型 id
LLM_MODEL=qwen2.5:7b
# ollama 服务地址（本机起了 Ollama 才用得到）
OLLAMA_URL=http://localhost:11434
# openai 模式才需要填：兼容端点和 Key
# ⚠ 阿里云百炼的域名，下面这行可作模板：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 召回多少块拼进 prompt
RAG_TOP_K=5
# 单块上下文拼进 prompt 的最大字符数
RAG_CONTEXT_MAX_CHARS=1200
