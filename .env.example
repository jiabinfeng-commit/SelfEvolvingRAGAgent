# =============================================================================
# .env.example —— 配置模板，复制为 .env 后填入真实值
#
#   cp .env.example .env        # 本地
#   # 云上部署：手动编辑 /opt/rag-agent/app/.env（详见 docs/15-云服务器部署.md）
#
# 注意：
#   - .env 已加入 .gitignore，**不会被提交**，放心填真实密码
#   - .env.example 没有真实值，会被提交，作为团队模板
#   - 优先级：系统环境变量 > .env > 代码默认值
# =============================================================================


# ---------- PostgreSQL ----------
# 存 chunk 原文与元数据
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag
PG_USER=rag
# 本地起一个最简 PG（Docker）：
#   docker run -d --name rag-pg -p 5432:5432 \
#     -e POSTGRES_USER=rag -e POSTGRES_PASSWORD=你的密码 -e POSTGRES_DB=rag \
#     postgres:16
PG_PASSWORD=请填写真实密码，不要提交到 git


# ---------- Milvus Lite ----------
# 只需要改路径的话改这里
MILVUS_PATH=
MILVUS_COLLECTION=chunks


# ---------- Embedding ----------
# 模型根目录，scripts/fetch_model.py 会把模型放在 {MODEL_ROOT}/BAAI__bge-small-zh-v1.5
MODEL_ROOT=
# 想要换别的模型可以覆盖这个 id
EMBED_MODEL=
EMBED_DIM=512
EMBED_BATCH_SIZE=32


# ---------- 路径 ----------
# 云上部署留空会自动用 /opt/rag-agent 作为基准（详见 docs/15）；本地一般不设，留空即项目根
# 如需覆盖可显式指定，比如 RAG_BASE_DIR=/Users/you/projects/Self_Evolving_RAG_Agent
RAG_BASE_DIR=
RAG_CORPUS_DIR=


# ---------- HuggingFace 镜像 ----------
# 国内直连 huggingface.co 不通，sentence-transformers 去 HF 取模型会卡死。
# 默认走社区的 hf-mirror.com；想切回官方源就改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com


# ---------- Reranker（召回精排，可选） ----------
# 作用：在「向量 + BM25 混合检索」RRF 融合之后，再用 cross-encoder 对候选块重排，提升 Top 命中率
# 默认 auto：优先用 cross-encoder（BAAI/bge-reranker-v2-m3）；
#           本地没缓存该模型 / 没装 sentence_transformers 时自动退 bi（复用 embedding 模型重编码，零额外下载）
# 想离线零依赖跑通：保持默认即可
# 想最高精度：把 cross 模型下到本地（scripts/fetch_model.py 走 ModelScope）+ 装 sentence_transformers，重启即自动升级
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto | cross | bi
RERANKER_MODE=auto
# 融合后先取前 N 个候选送 rerank，再按 rerank 分数回 top_k
RERANKER_CANDIDATE_TOP_N=20


# ---------- 联网调研（阶段 6）的网络探测 ----------
# 国内网络访问 duckduckgo / google 等境外站点时，TCP 握手得不到任何响应
# （连接停在 SYN_SENT，既不成功也不被拒绝），按 timeout 硬等会白耗很久。
# 所以 run_self_heal 在进入"联网调研循环"前先做一次 TCP 连通性探测：
#   不通 → 直接跳过调研、保持拒答（而不是每轮空等 timeout=10s × max_steps）
# 换了搜索后端就同步改这里的 host / port。
NET_PROBE_HOST=html.duckduckgo.com
NET_PROBE_PORT=443
NET_PROBE_TIMEOUT=3


# =============================================================================
# ⚠ 注意：dotenv 只在 # 前有空白时才把 # 当注释。
#   写成 `KEY=value# 说明`（# 紧贴 value）时，说明文字会被当成值的一部分！
#   反例：RERANKER_CANDIDATE_TOP_N=20# 说明  →  值变成 "20# 说明"，int() 直接报错。
#   所以注释请单独占一行，或至少写成 `KEY=value  # 说明`（# 前留空格）。
# =============================================================================



# ---------- LLM（阶段 2：生成答案用） ----------
# 后端：ollama（本地免费，默认） | openai（OpenAI 兼容 API）
LLM_BACKEND=ollama
# ollama 模式填本地模型名；openai 模式填模型 id
LLM_MODEL=qwen2.5:7b
# ollama 服务地址（本机起了 Ollama 才用得到）
OLLAMA_URL=http://localhost:11434
# openai 模式才需要填：兼容端点和 Key
# ⚠ 阿里云百炼的域名，下面这行可作模板：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 召回多少块拼进 prompt
RAG_TOP_K=5
# 单块上下文拼进 prompt 的最大字符数
RAG_CONTEXT_MAX_CHARS=1200
